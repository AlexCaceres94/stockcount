{
  "expo": {
    "name": "StockCount",
    "slug": "stockcount",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "stockcount",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stockcount.app",
      "infoPlist": {
        "NSCameraUsageDescription": "StockCount needs your camera to scan item barcodes and take item photos.",
        "NSLocationWhenInUseDescription": "StockCount tags each inventory count with your location so you know where a count was taken."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.stockcount.app",
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "StockCount needs your camera to scan item barcodes and take item photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "StockCount tags each inventory count with your location so you know where a count was taken."
        }
      ]
    ]
  }
}
